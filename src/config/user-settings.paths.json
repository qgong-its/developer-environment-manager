{
  "name": "user-settings",
  "dotfilesPath": "user-settings",
  "items": [
    {
      "id": "common/gitconfig",
      "description": "Git configs",
      "dotfilesPath": "user-settings/common/.gitconfig",
      "targets": {
        "windows": ".gitconfig",
        "linux": ".gitconfig"
      }
    },
    {
      "id": "common/gitignore_global",
      "description": "Git global ignores",
      "dotfilesPath": "user-settings/common/.gitignore_global",
      "targets": {
        "windows": ".gitignore_global",
        "linux": ".gitignore_global"
      }
    },
    {
      "id": "common/gitconfig_local",
      "description": "Git local configs",
      "dotfilesPath": "user-settings/common/.gitconfig.local",
